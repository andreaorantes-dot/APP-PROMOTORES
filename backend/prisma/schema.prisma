// Esquema de datos — App Promotores
// Motor: en los servidores (Render) es PostgreSQL; en local es SQLite
// (DATABASE_URL="file:./dev.db"). El provider de abajo debe COINCIDIR con el
// motor real: por eso en local va "sqlite" (cambio gestionado con skip-worktree,
// no se sube al repo). El resto del código (queries Prisma) es idéntico.
//
// NOTA (corrección 22/08/2026): el provider estaba corrupto ("postgresql{}][]"),
// lo que rompía `prisma db push` / `generate`. Se corrigió a "sqlite" para el
// entorno local. En los servidores debe ser "postgresql".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Promoter {
  id                 String              @id // ID de promotor (número de la BBDD)
  name               String
  location           String? // UBICACION
  supervisor         String? // SUPERVISOR
  password           String // hash bcrypt de la contraseña (nunca en texto plano)
  createdAt          DateTime            @default(now())
  visits             VisitRecord[]
  competitionReports CompetitionReport[]
}

// Catálogo GLOBAL de tiendas (sin asignación por promotor). La visibilidad se
// resuelve por cercanía geográfica en tiempo real (GET /api/stores?lat&lng).
model Store {
  id      String        @id
  name    String
  address String
  lat     Float
  lng     Float
  estado  String? // ESTADO de México (columna "Estado" de la pestaña Tiendas). Usado por el filtro del gerente.
  visits  VisitRecord[]
}

model VisitRecord {
  id               String    @id @default(uuid())
  promoter         Promoter  @relation(fields: [promoterId], references: [id])
  promoterId       String
  store            Store     @relation(fields: [storeId], references: [id])
  storeId          String
  day              String // YYYY-MM-DD — 1 visita por promotor/tienda/día
  status           String // "checked-in" | "checked-out"
  checkInTime      DateTime?
  checkInDistance  Int?
  checkOutTime     DateTime?
  checkOutDistance Int?
  rollos           Int       @default(0)
  cubetas          Int       @default(0)
  galones          Int       @default(0)
  photo            String? // foto de la visita en Base64 (data URL), persistida
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([promoterId, storeId, day])
  @@index([promoterId, day])
}

// Reporte de acciones/estrategias de la competencia, capturado desde la
// pantalla "Competencia" de la app del promotor. Las fotos se guardan aquí
// (Base64, como VisitRecord.photo) — un Sheet no es buen lugar para binarios;
// el Sheet solo recibe una fila-resumen (ver competitionSheet.js).
model CompetitionReport {
  id          String   @id @default(uuid())
  promoter    Promoter @relation(fields: [promoterId], references: [id])
  promoterId  String
  marca       String
  descripcion String
  photos      String? // JSON: array de fotos en Base64 (data URL)
  createdAt   DateTime @default(now())

  @@index([promoterId])
}
