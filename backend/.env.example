# ---------------------------------------------------------------------------
# Backend Promotores — configuración
# ---------------------------------------------------------------------------

# Puerto del servidor.
PORT=8080

# Origen del frontend permitido para CORS (con credenciales).
CORS_ORIGIN=http://localhost:5173

# --- Base de datos (Prisma) ------------------------------------------------
# SQLite local por defecto. Para PostgreSQL en prod, cambia
# `provider = "postgresql"` en prisma/schema.prisma y usa un URL como:
# DATABASE_URL="postgresql://user:pass@host:5432/promotores?schema=public"
DATABASE_URL="file:./dev.db"

# Ruta al CSV para el seed (por defecto, la raíz del proyecto: ../Promotores.csv).
# SEED_CSV_PATH=../Promotores.csv

# Radio de check-in en metros (GPS real). Protexa: 100 m.
CHECK_IN_RADIUS_METERS=100

# Radio (m) para listar tiendas cercanas en GET /api/stores?lat&lng.
NEARBY_RADIUS_METERS=2000

# --- Sesión ----------------------------------------------------------------
# Secreto para firmar el JWT de sesión que va dentro de la cookie HttpOnly.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
# Duración de la sesión (segundos). 8h por defecto.
SESSION_TTL_SECONDS=28800
# 'true' en producción (HTTPS) para marcar la cookie como Secure.
COOKIE_SECURE=false

# --- Google Sheets (admin) — opcional --------------------------------------
# Al hacer check-out se agrega una fila con los datos de la visita al Sheet.
# 1) Crea un Service Account en Google Cloud y descarga su clave JSON.
# 2) Habilita la Google Sheets API.
# 3) Comparte el documento con el client_email del Service Account (editor).
# Si estos valores quedan vacíos, la integración se omite (no rompe el check-out).
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./credentials/service-account.json
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Visitas
